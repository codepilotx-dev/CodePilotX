{
  "name": "@codepilotx/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:js": "bun build src/index.ts --target=bun --outdir=dist",
    "build": "bun build src/index.ts --compile --outfile=dist/codepilotx-agent.exe",
    "compile": "bun run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.82",
    "@ai-sdk/openai": "3.0.53",
    "@ai-sdk/openai-compatible": "2.0.41",
    "@anthropic-ai/sandbox-runtime": "0.0.65",
    "@codepilotx/agent-protocol": "workspace:*",
    "@codepilotx/model-schema": "workspace:*",
    "@codepilotx/provider-plugin": "workspace:*",
    "@codepilotx/provider-runtime": "workspace:*",
    "@codepilotx/shared": "workspace:*",
    "@openai/agents": "0.13.3",
    "@openai/agents-extensions": "0.13.3",
    "ai": "6.0.168",
    "effect": "4.0.0-beta.83",
    "hono": "4.10.7",
    "yaml": "2.9.0",
    "zod": "4"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": "1.3.14"
  }
}
