{
  "name": "@codepilotx/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:js": "bun build src/index.ts --target=bun --outdir=dist",
    "build": "bun ../../scripts/build-agent-win-x64.ts",
    "compile": "bun run build"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.65",
    "@codepilotx/agent-protocol": "workspace:*",
    "@codepilotx/model-schema": "workspace:*",
    "@codepilotx/pi-agent-core": "workspace:*",
    "@codepilotx/provider-plugin": "workspace:*",
    "@codepilotx/provider-runtime": "workspace:*",
    "@codepilotx/shared": "workspace:*",
    "@earendil-works/pi-ai": "0.81.0",
    "effect": "4.0.0-beta.83",
    "extract-zip": "2.0.1",
    "hono": "4.10.7",
    "yaml": "2.9.0",
    "zod": "4"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": "1.3.14"
  }
}
