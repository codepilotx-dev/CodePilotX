{
  "name": "@codepilotx/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Electron desktop app for CodePilotX. Drives the OpenAI Codex CLI `app-server` JSON-RPC interface through the @codepilotx/codex-app-server-client package, with @codepilotx/desktop-compat supplying transitional @codepilotx/core and @codepilotx/tui aliases.",
  "main": "./dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/desktop-dev.mjs",
    "dev:subprocess": "node ../../scripts/desktop-dev.mjs --subprocess",
    "build": "vite build --config vite.desktop.main.config.ts && vite build --config vite.desktop.preload.config.ts && vite build --config vite.desktop.config.ts",
    "build:debug": "node ../../scripts/desktop-build-debug.mjs",
    "agent:build": "echo 'Phase 2: codex app-server handles the agent role; this script is a no-op until Phase 5 packaging.'",
    "dist:win": "node ../../scripts/clean-desktop-dist.mjs && pnpm run agent:build && pnpm run build && electron-builder --win --config electron-builder.config.cjs",
    "typecheck": "tsc --noEmit --noCheck -p tsconfig.typecheck.json",
    "test": "bun test"
  },
  "dependencies": {
    "@codepilotx/codex-app-server-client": "workspace:*",
    "@codepilotx/desktop-compat": "workspace:*",
    "@ai-sdk/anthropic": "^3.0.6",
