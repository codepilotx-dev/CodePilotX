{
  "name": "@codepilotx/desktop-electron",
  "version": "0.2.0-beta.2",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && bun build src/main.ts --target=node --format=esm --outdir=dist --external electron --sourcemap=external",
    "dev": "bun run build && electron .",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:plan": "playwright test --config playwright.plan.config.ts",
    "package:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "@codepilotx/shared": "workspace:*",
    "@playwright/test": "1.55.1",
    "@types/node": "^24.0.0",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "typescript": "~5.8.3"
  },
  "build": {
    "appId": "com.codepilotx.desktop",
    "productName": "CodePilotX",
    "asar": true,
    "directories": {
      "output": "../../../release",
      "buildResources": "../build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "../build/whale-icon.svg",
        "to": "whale-icon.svg"
      },
      {
        "from": "../../agent/dist/x64/codepilotx-agent.exe",
        "to": "agent/codepilotx-agent.exe"
      },
      {
        "from": "../../../dist/renderer",
        "to": "renderer"
      },
      {
        "from": "../../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../../third_party",
        "to": "third_party"
      },
      {
        "from": "../../../packages/pi-agent-core/LICENSE",
        "to": "packages/pi-agent-core/LICENSE"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": "nsis",
      "artifactName": "CodePilotX-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "smol-toml": "^1.7.0"
  }
}
