{
  "styleEntrypoint": "src/styles/index.scss",
  "styleEntrypointImporter": "src/main.tsx",
  "cascadeLayerOrder": [
    "theme",
    "vendor",
    "reset",
    "tokens",
    "primitives",
    "shell",
    "features",
    "utilities",
    "overrides"
  ],
  "utilityContract": {
    "source": "src/styles/design-system/utilities.scss",
    "prefix": "u-",
    "maxSelectors": 220,
    "maxBytes": 18432,
    "maxGzipBytes": 4096
  },
  "directStyleImportAllowlist": [
    "src/main.tsx -> src/styles/tailwind.css",
    "src/features/pet/PetCatalogPage.tsx -> src/styles/lazy/pet-catalog.scss",
    "src/features/pet/PetOverlayPage.tsx -> src/styles/lazy/pet-overlay.scss",
    "src/features/models/ModelCenterView.tsx -> src/styles/lazy/model-center.scss",
    "src/features/models/setup/ModelSetupPage.tsx -> src/styles/lazy/model-setup.scss",
    "src/features/taskboard/components/TaskboardGantt.tsx -> src/styles/lazy/taskboard-gantt-vendor.scss",
    "src/features/taskboard/TaskboardView.tsx -> src/styles/lazy/taskboard.scss",
    "src/features/plugins/PluginsView.tsx -> src/styles/lazy/marketplace.scss",
    "src/features/settings/SettingsLayout.tsx -> src/styles/lazy/settings.scss",
    "src/features/terminal/TerminalPanel.tsx -> src/styles/lazy/terminal.scss",
    "src/features/whats-new/WhatsNewDialog.tsx -> src/styles/lazy/whats-new.scss"
  ],
  "lazyStyleEntrypoints": {
    "src/styles/lazy/marketplace.scss": "features",
    "src/styles/lazy/model-center.scss": "features",
    "src/styles/lazy/model-setup.scss": "features",
    "src/styles/lazy/pet-catalog.scss": "features",
    "src/styles/lazy/pet-overlay.scss": "features",
    "src/styles/lazy/settings.scss": "features",
    "src/styles/lazy/taskboard-gantt-vendor.scss": "vendor",
    "src/styles/lazy/taskboard.scss": "features",
    "src/styles/lazy/terminal.scss": "vendor",
    "src/styles/lazy/whats-new.scss": "features"
  },
  "customPropertyReferenceAllowlist": [
    "--inline-approval-card-radius",
    "--popover-overflow-x",
    "--radix-context-menu-content-transform-origin",
    "--radix-context-menu-content-available-height",
    "--radix-dropdown-menu-content-transform-origin",
    "--radix-dropdown-menu-content-available-height",
    "--radix-menubar-content-transform-origin",
    "--radix-menubar-content-available-height",
    "--radix-popover-content-transform-origin",
    "--radix-popover-content-available-height",
    "--radix-select-content-transform-origin",
    "--radix-select-content-available-height",
    "--radix-select-trigger-width",
    "--radix-tooltip-content-transform-origin"
  ],
  "forbiddenCustomPropertyPatterns": [
    "^--color-bg(?:-|$)",
    "^--surface-",
    "^--border-(?:subtle|muted|control|strong)$",
    "^--color-text(?:$|-(?:strong|meta|soft|mute|muted|placeholder|disabled|on-accent)$)"
  ],
  "importantDeclarationAllowlist": {
    "src/styles/base.scss": 8,
    "src/styles/popover.scss": 1
  },
  "dataThemeSelectorAllowlist": {
    "src/styles/features/model-center.scss": 2
  },
  "literalLineHeightAllowlist": {
    "src/styles/modal.scss": 2
  },
  "tailwindLeadingAllowlist": {},
  "featureColorContract": {
    "roots": [
      "src/styles/features",
      "src/styles/lazy"
    ],
    "componentTokenExceptions": [
      {
        "file": "src/styles/features/_terminal.scss",
        "token": "--cpx-comp-terminal-bg",
        "reason": "Terminal adapter consumes the terminal component palette as one indivisible third-party surface."
      },
      {
        "file": "src/styles/features/_terminal.scss",
        "token": "--cpx-comp-terminal-fg",
        "reason": "Terminal adapter consumes the terminal component palette as one indivisible third-party surface."
      }
    ],
    "literalColorExceptions": [
      {
        "file": "src/styles/features/_settings-appearance.scss",
        "value": "#f3f3f3",
        "reason": "Theme mode thumbnail previews a fixed light palette independent of the active theme."
      },
      {
        "file": "src/styles/features/_settings-appearance.scss",
        "value": "#5d5d5d",
        "reason": "Theme mode thumbnail previews a fixed dark palette independent of the active theme."
      },
      {
        "file": "src/styles/features/_settings-appearance.scss",
        "value": "#9f9f9f",
        "reason": "System-theme thumbnail shows a fixed light/dark split independent of the active theme."
      },
      {
        "file": "src/styles/features/_settings-appearance.scss",
        "value": "#000",
        "reason": "Color picker saturation/value gradient must terminate at absolute black."
      },
      {
        "file": "src/styles/features/_settings-appearance.scss",
        "value": "#fff",
        "reason": "Color picker gradient and handles require absolute white independent of the active theme."
      },
      {
        "file": "src/styles/features/_settings-appearance.scss",
        "value": "rgb(0 0 0 / 40%)",
        "reason": "Color picker handle needs a theme-independent contrast ring."
      },
      {
        "file": "src/styles/features/_settings-appearance.scss",
        "value": "#f00",
        "reason": "Hue picker spectrum uses absolute color stops."
      },
      {
        "file": "src/styles/features/_settings-appearance.scss",
        "value": "#ff0",
        "reason": "Hue picker spectrum uses absolute color stops."
      },
      {
        "file": "src/styles/features/_settings-appearance.scss",
        "value": "#0f0",
        "reason": "Hue picker spectrum uses absolute color stops."
      },
      {
        "file": "src/styles/features/_settings-appearance.scss",
        "value": "#0ff",
        "reason": "Hue picker spectrum uses absolute color stops."
      },
      {
        "file": "src/styles/features/_settings-appearance.scss",
        "value": "#00f",
        "reason": "Hue picker spectrum uses absolute color stops."
      },
      {
        "file": "src/styles/features/_settings-appearance.scss",
        "value": "#f0f",
        "reason": "Hue picker spectrum uses absolute color stops."
      }
    ],
    "colorMixExceptions": [
      {
        "file": "src/styles/features/_settings-billing.scss",
        "localProperty": "--usage-chart-1",
        "reason": "Usage heatmap intentionally interpolates a data-series color against the semantic surface."
      },
      {
        "file": "src/styles/features/_settings-billing.scss",
        "localProperty": "--usage-chart-3",
        "reason": "Usage chart intentionally interpolates a data-series color against the semantic border."
      }
    ]
  },
  "featureTokenContract": {
    "roots": [
      "src/styles/features",
      "src/styles/lazy"
    ],
    "scriptRoots": [
      "src/features",
      "src/components"
    ],
    "componentGeometryExceptions": [],
    "inlineStyleExceptions": [],
    "tailwindArbitraryExceptions": [],
    "literalTypographyExceptions": [],
    "literalRadiusExceptions": [],
    "literalMotionExceptions": [],
    "literalShadowExceptions": [
      {
        "file": "src/styles/features/_settings-appearance.scss",
        "property": "box-shadow",
        "value": "0 0 0 1px color-mix(in srgb, currentColor 10%, transparent)",
        "reason": "The configurable color swatch needs a neutral outline derived from its dynamic currentColor."
      },
      {
        "file": "src/styles/features/_settings-appearance.scss",
        "property": "box-shadow",
        "value": "0 0 0 1px rgb(0 0 0 / 40%)",
        "reason": "Color picker thumbs need a fixed dark contrast outline over arbitrary user-selected hues."
      }
    ],
    "literalZIndexExceptions": [
      {
        "file": "src/styles/features/_composer-shell.scss",
        "property": "z-index",
        "value": "1",
        "reason": "Composer utility surface uses local ordering inside the isolated composer stacking context."
      },
      {
        "file": "src/styles/features/_composer-shell.scss",
        "property": "z-index",
        "value": "2",
        "reason": "Composer input surface stays above its utility sibling inside the isolated composer stacking context."
      },
      {
        "file": "src/styles/features/layout-sidebar.scss",
        "property": "z-index",
        "value": "1",
        "reason": "The docked sidebar uses local sibling ordering inside its positioned dock container."
      },
      {
        "file": "src/styles/features/_layout-workspace-header.scss",
        "property": "z-index",
        "value": "1",
        "reason": "Workspace header route groups use local grid-item ordering inside the dock layer."
      },
      {
        "file": "src/styles/features/_session-page.scss",
        "property": "z-index",
        "value": "2",
        "reason": "Focused composer actions use local ordering inside the isolated composer control group."
      }
    ],
    "literalSpacingExceptions": []
  },
  "interactionContract": {
    "interactiveRowAllowedFiles": [
      "src/components/ui/PopoverItem.tsx",
      "src/components/ui/SearchablePopoverContent.tsx",
      "src/features/session/summary/ThreadSummaryPanel.tsx"
    ]
  }
}
