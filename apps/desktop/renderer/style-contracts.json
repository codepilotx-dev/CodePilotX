{
  "styleEntrypoint": "src/styles/index.scss",
  "styleEntrypointImporter": "src/main.tsx",
  "cascadeLayerOrder": [
    "theme",
    "vendor",
    "reset",
    "tokens",
    "primitives",
    "shell",
    "features",
    "utilities",
    "overrides"
  ],
  "utilityContract": {
    "source": "src/styles/design-system/utilities.scss",
    "prefix": "u-",
    "maxSelectors": 220,
    "maxBytes": 18432,
    "maxGzipBytes": 4096
  },
  "directStyleImportAllowlist": [
    "src/main.tsx -> src/styles/tailwind.css",
    "src/features/labs/LabsPage.tsx -> src/styles/lazy/labs.scss",
    "src/features/settings/SettingsLayout.tsx -> src/styles/lazy/settings.scss"
  ],
  "lazyStyleEntrypoints": {
    "src/styles/lazy/labs.scss": "features",
    "src/styles/lazy/settings.scss": "features"
  },
  "customPropertyReferenceAllowlist": [
    "--button-font-size",
    "--button-gap",
    "--button-line-height",
    "--button-padding",
    "--inline-approval-card-margin-bottom",
    "--inline-approval-card-radius",
    "--popover-overflow-x",
    "--radix-select-trigger-width"
  ],
  "forbiddenCustomPropertyPatterns": [
    "^--color-bg(?:-|$)",
    "^--surface-",
    "^--state-",
    "^--border-(?:subtle|muted|control|strong)$",
    "^--color-text(?:$|-(?:strong|meta|soft|mute|muted|placeholder|disabled|on-accent)$)"
  ],
  "importantDeclarationAllowlist": {
    "src/styles/base.scss": 12,
    "src/styles/popover.scss": 1
  },
  "dataThemeSelectorAllowlist": {
    "src/styles/features/model-center.scss": 2
  }
}
