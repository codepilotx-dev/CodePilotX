{
  "styleEntrypoint": "src/styles/index.scss",
  "styleEntrypointImporter": "src/main.tsx",
  "cascadeLayerOrder": [
    "theme",
    "vendor",
    "reset",
    "tokens",
    "primitives",
    "shell",
    "features",
    "utilities",
    "overrides"
  ],
  "utilityContract": {
    "source": "src/styles/design-system/utilities.scss",
    "prefix": "u-",
    "maxSelectors": 220,
    "maxBytes": 18432,
    "maxGzipBytes": 4096
  },
  "directStyleImportAllowlist": [
    "src/main.tsx -> src/styles/tailwind.css",
    "src/features/pet/PetCatalogPage.tsx -> src/styles/lazy/pet-catalog.scss",
    "src/features/pet/PetOverlayPage.tsx -> src/styles/lazy/pet-overlay.scss",
    "src/features/models/ModelCenterView.tsx -> src/styles/lazy/model-center.scss",
    "src/features/models/setup/ModelSetupPage.tsx -> src/styles/lazy/model-setup.scss",
    "src/features/taskboard/TaskboardView.tsx -> src/styles/lazy/taskboard.scss",
    "src/features/plugins/PluginsView.tsx -> src/styles/lazy/marketplace.scss",
    "src/features/settings/SettingsLayout.tsx -> src/styles/lazy/settings.scss",
    "src/features/terminal/TerminalPanel.tsx -> src/styles/lazy/terminal.scss",
    "src/features/whats-new/WhatsNewDialog.tsx -> src/styles/lazy/whats-new.scss"
  ],
  "lazyStyleEntrypoints": {
    "src/styles/lazy/marketplace.scss": "features",
    "src/styles/lazy/model-center.scss": "features",
    "src/styles/lazy/model-setup.scss": "features",
    "src/styles/lazy/pet-catalog.scss": "features",
    "src/styles/lazy/pet-overlay.scss": "features",
    "src/styles/lazy/settings.scss": "features",
    "src/styles/lazy/taskboard.scss": "features",
    "src/styles/lazy/terminal.scss": "vendor",
    "src/styles/lazy/whats-new.scss": "features"
  },
  "customPropertyReferenceAllowlist": [
    "--inline-approval-card-margin-bottom",
    "--inline-approval-card-radius",
    "--popover-overflow-x",
    "--radix-context-menu-content-transform-origin",
    "--radix-context-menu-content-available-height",
    "--radix-dropdown-menu-content-transform-origin",
    "--radix-dropdown-menu-content-available-height",
    "--radix-menubar-content-transform-origin",
    "--radix-menubar-content-available-height",
    "--radix-popover-content-transform-origin",
    "--radix-popover-content-available-height",
    "--radix-select-content-transform-origin",
    "--radix-select-content-available-height",
    "--radix-select-trigger-width",
    "--radix-tooltip-content-transform-origin"
  ],
  "forbiddenCustomPropertyPatterns": [
    "^--color-bg(?:-|$)",
    "^--surface-",
    "^--border-(?:subtle|muted|control|strong)$",
    "^--color-text(?:$|-(?:strong|meta|soft|mute|muted|placeholder|disabled|on-accent)$)"
  ],
  "importantDeclarationAllowlist": {
    "src/styles/base.scss": 8,
    "src/styles/popover.scss": 1
  },
  "dataThemeSelectorAllowlist": {
    "src/styles/features/model-center.scss": 2
  },
  "literalLineHeightAllowlist": {
    "src/styles/components/button.scss": 13,
    "src/styles/features/_composer-shell.scss": 1,
    "src/styles/features/_file-editor.scss": 1,
    "src/styles/features/_session-approvals.scss": 1,
    "src/styles/features/_settings-billing.scss": 2,
    "src/styles/features/_settings-connections.scss": 1,
    "src/styles/features/_settings-core.scss": 1,
    "src/styles/features/_settings-profile.scss": 1,
    "src/styles/features/layout-sidebar.scss": 2,
    "src/styles/features/marketplace.scss": 1,
    "src/styles/features/review.scss": 5,
    "src/styles/modal.scss": 2
  },
  "tailwindLeadingAllowlist": {}
}
