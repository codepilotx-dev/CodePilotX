{
  "name": "@codepilotx/renderer",
  "private": true,
  "version": "0.2.0-beta.2",
  "type": "module",
  "scripts": {
    "css:check": "stylelint \"src/**/*.{css,scss}\" --max-warnings 0 && bun run scripts/check-style-contracts.ts",
    "styles:codex:inventory": "bun run scripts/inventory-codex-styles.ts",
    "styles:codex:check": "bun run scripts/inventory-codex-styles.ts --check --fail-on-parse-error",
    "themes:codex:generate": "bun run scripts/generate-codex-themes.ts",
    "themes:codex:check": "bun run scripts/generate-codex-themes.ts --check",
    "dev": "vite --host 127.0.0.1 --port 7788",
    "typecheck": "tsc -b",
    "test": "bun test test",
    "test:visual": "playwright test --config playwright.config.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@codepilotx/agent-protocol": "workspace:*",
    "@codepilotx/material-icon-theme": "workspace:*",
    "@codepilotx/session-view": "workspace:*",
    "@codepilotx/shared": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-context-menu": "^2.3.1",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-menubar": "^1.1.17",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.0",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.9",
    "katex": "0.17.0",
    "lucide-react": "0.468.0",
    "marked": "18.0.6",
    "mermaid": "11.16.0",
    "misans": "4.1.0",
    "motion": "^12.40.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.41.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.17.0",
    "shiki": "4.3.1",
    "virtua": "0.49.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "lightningcss": "1.32.0",
    "postcss": "^8.5.19",
    "postcss-scss": "^4.0.9",
    "postcss-selector-parser": "^7.1.4",
    "postcss-value-parser": "^4.2.0",
    "sass": "^1.101.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
