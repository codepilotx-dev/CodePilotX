{
  "name": "codepilotx-local",
  "version": "0.0.0-local",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "main": "./dist/desktop/main/index.js",
  "bin": {
    "codepilotx": "./dist/codepilotx.js"
  },
  "scripts": {
    "dev": "bun run build && bun dist/codepilotx.js",
    "build": "bun build --minify apps/tui/src/entrypoints/cli.tsx --target=bun --outfile=dist/codepilotx.js --define MACRO.VERSION='\"0.0.0-local\"' --define MACRO.BUILD_TIME='\"local\"' --define MACRO.PACKAGE_URL='\"codepilotx-local\"' --define MACRO.NATIVE_PACKAGE_URL='\"codepilotx-local-native\"' --define MACRO.FEEDBACK_CHANNEL='\"local\"' --define MACRO.ISSUES_EXPLAINER='\"open an issue in the local checkout\"' --define MACRO.VERSION_CHANGELOG='\"Local development build\"' --define process.env.USER_TYPE='\"external\"' --define process.env.NODE_ENV='\"development\"' --define process.env.CODEPILOTX_DISABLE_MDM_READ='\"1\"' --define process.env.CODEPILOTX_DISABLE_MIN_VERSION_CHECK='\"1\"' --define process.env.CLAUDE_CODE_DISABLE_MDM_READ='\"1\"' --define process.env.CLAUDE_CODE_DISABLE_MIN_VERSION_CHECK='\"1\"'",
    "typecheck": "tsc --noEmit --noCheck -p packages/core/tsconfig.json && tsc --noEmit --noCheck -p apps/tui/tsconfig.json && bun run desktop:typecheck",
    "desktop:typecheck": "tsc --noEmit -p apps/desktop/tsconfig.typecheck.json",
    "smoke": "bun dist/codepilotx.js --version && bun dist/codepilotx.js --help",
    "check": "bun run typecheck && bun run build && bun run smoke",
    "deps:audit": "node scripts/deps-audit.mjs",
    "desktop:agent:build": "bun build --minify apps/tui/src/entrypoints/cli.tsx --compile --outfile=dist/desktop-agent/codepilotx-local.exe --define MACRO.VERSION='\"0.0.0-local\"' --define MACRO.BUILD_TIME='\"local\"' --define MACRO.PACKAGE_URL='\"codepilotx-local\"' --define MACRO.NATIVE_PACKAGE_URL='\"codepilotx-local-native\"' --define MACRO.FEEDBACK_CHANNEL='\"local\"' --define MACRO.ISSUES_EXPLAINER='\"open an issue in the local checkout\"' --define MACRO.VERSION_CHANGELOG='\"Local development build\"' --define process.env.USER_TYPE='\"external\"' --define process.env.NODE_ENV='\"development\"' --define process.env.CODEPILOTX_DISABLE_MDM_READ='\"1\"' --define process.env.CODEPILOTX_DISABLE_MIN_VERSION_CHECK='\"1\"' --define process.env.CLAUDE_CODE_DISABLE_MDM_READ='\"1\"' --define process.env.CLAUDE_CODE_DISABLE_MIN_VERSION_CHECK='\"1\"'",
    "desktop:dev": "bun scripts/desktop-dev.mjs",
    "desktop:dev:subprocess": "bun scripts/desktop-dev.mjs --subprocess",
    "desktop:build": "vite build --config apps/desktop/vite.desktop.main.config.ts && vite build --config apps/desktop/vite.desktop.preload.config.ts && vite build --config apps/desktop/vite.desktop.config.ts",
    "desktop:build:debug": "bun scripts/desktop-build-debug.mjs",
    "desktop:dist:win": "bun scripts/clean-desktop-dist.mjs && bun run desktop:agent:build && bun run desktop:build && electron-builder --win --config apps/desktop/electron-builder.config.cjs"
  },
  "dependencies": {
