{
  "name": "claudecode-local",
  "version": "0.0.0-local",
  "private": true,
  "type": "module",
  "bin": {
    "claude-local": "./dist/claude.js"
  },
  "scripts": {
    "dev": "bun run build && bun dist/claude.js",
    "build": "bun build entrypoints/cli.tsx --target=bun --outfile=dist/claude.js --define MACRO.VERSION='\"0.0.0-local\"' --define MACRO.BUILD_TIME='\"local\"' --define MACRO.PACKAGE_URL='\"claudecode-local\"' --define MACRO.NATIVE_PACKAGE_URL='\"claudecode-local-native\"' --define MACRO.FEEDBACK_CHANNEL='\"local\"' --define MACRO.ISSUES_EXPLAINER='\"open an issue in the local checkout\"' --define MACRO.VERSION_CHANGELOG='\"Local development build\"' --define process.env.USER_TYPE='\"external\"' --define process.env.NODE_ENV='\"development\"' --define process.env.CLAUDE_CODE_DISABLE_MDM_READ='\"1\"' --define process.env.CLAUDE_CODE_DISABLE_MIN_VERSION_CHECK='\"1\"'",
    "typecheck": "tsc --noEmit --noCheck",
    "smoke": "bun dist/claude.js --version && bun dist/claude.js --help",
    "check": "bun run typecheck && bun run build && bun run smoke",
    "deps:audit": "node scripts/deps-audit.mjs"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "latest",
    "@anthropic-ai/bedrock-sdk": "latest",
