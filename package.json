{
  "name": "claudecode-local",
  "version": "0.0.0-local",
  "private": true,
  "type": "module",
  "main": "./dist/desktop/main/index.js",
  "bin": {
    "claude-local": "./dist/claude.js"
  },
  "scripts": {
    "dev": "bun run build && bun dist/claude.js",
    "build": "bun build src/entrypoints/cli.tsx --target=bun --outfile=dist/claude.js --define MACRO.VERSION='\"0.0.0-local\"' --define MACRO.BUILD_TIME='\"local\"' --define MACRO.PACKAGE_URL='\"claudecode-local\"' --define MACRO.NATIVE_PACKAGE_URL='\"claudecode-local-native\"' --define MACRO.FEEDBACK_CHANNEL='\"local\"' --define MACRO.ISSUES_EXPLAINER='\"open an issue in the local checkout\"' --define MACRO.VERSION_CHANGELOG='\"Local development build\"' --define process.env.USER_TYPE='\"external\"' --define process.env.NODE_ENV='\"development\"' --define process.env.CLAUDE_CODE_DISABLE_MDM_READ='\"1\"' --define process.env.CLAUDE_CODE_DISABLE_MIN_VERSION_CHECK='\"1\"'",
    "typecheck": "tsc --noEmit --noCheck",
    "smoke": "bun dist/claude.js --version && bun dist/claude.js --help",
    "check": "bun run typecheck && bun run build && bun run smoke",
    "deps:audit": "node scripts/deps-audit.mjs",
    "desktop:agent:build": "bun build src/entrypoints/cli.tsx --compile --outfile=dist/desktop-agent/claude-local.exe --define MACRO.VERSION='\"0.0.0-local\"' --define MACRO.BUILD_TIME='\"local\"' --define MACRO.PACKAGE_URL='\"claudecode-local\"' --define MACRO.NATIVE_PACKAGE_URL='\"claudecode-local-native\"' --define MACRO.FEEDBACK_CHANNEL='\"local\"' --define MACRO.ISSUES_EXPLAINER='\"open an issue in the local checkout\"' --define MACRO.VERSION_CHANGELOG='\"Local development build\"' --define process.env.USER_TYPE='\"external\"' --define process.env.NODE_ENV='\"development\"' --define process.env.CLAUDE_CODE_DISABLE_MDM_READ='\"1\"' --define process.env.CLAUDE_CODE_DISABLE_MIN_VERSION_CHECK='\"1\"'",
    "desktop:dev": "bun run desktop:agent:build && bun run desktop:build && electron dist/desktop/main/index.js",
    "desktop:build": "vite build --config vite.desktop.main.config.ts && vite build --config vite.desktop.preload.config.ts && vite build --config vite.desktop.config.ts",
    "desktop:dist:win": "bun run desktop:agent:build && bun run desktop:build && electron-builder --win --config electron-builder.config.cjs"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "latest",
    "@anthropic-ai/bedrock-sdk": "latest",
    "@anthropic-ai/claude-agent-sdk": "latest",
    "@anthropic-ai/foundry-sdk": "latest",
    "@anthropic-ai/mcpb": "latest",
    "@anthropic-ai/sandbox-runtime": "latest",
    "@anthropic-ai/sdk": "latest",
    "@anthropic-ai/vertex-sdk": "latest",
    "@aws-sdk/client-bedrock": "latest",
    "@aws-sdk/client-bedrock-runtime": "latest",
    "@aws-sdk/client-sts": "latest",
    "@aws-sdk/credential-provider-node": "latest",
    "@azure/identity": "latest",
    "@commander-js/extra-typings": "latest",
    "@growthbook/growthbook": "latest",
    "@modelcontextprotocol/sdk": "latest",
    "@opentelemetry/api": "latest",
    "@opentelemetry/api-logs": "latest",
    "@opentelemetry/core": "latest",
    "@opentelemetry/exporter-logs-otlp-grpc": "latest",
    "@opentelemetry/exporter-logs-otlp-http": "latest",
    "@opentelemetry/exporter-logs-otlp-proto": "latest",
    "@opentelemetry/exporter-metrics-otlp-grpc": "latest",
    "@opentelemetry/exporter-metrics-otlp-http": "latest",
    "@opentelemetry/exporter-metrics-otlp-proto": "latest",
    "@opentelemetry/exporter-prometheus": "latest",
    "@opentelemetry/exporter-trace-otlp-grpc": "latest",
    "@opentelemetry/exporter-trace-otlp-http": "latest",
    "@opentelemetry/exporter-trace-otlp-proto": "latest",
    "@opentelemetry/resources": "latest",
    "@opentelemetry/sdk-logs": "latest",
    "@opentelemetry/sdk-metrics": "latest",
    "@opentelemetry/sdk-trace-base": "latest",
    "@opentelemetry/semantic-conventions": "latest",
    "@smithy/node-http-handler": "latest",
    "ajv": "latest",
    "asciichart": "latest",
    "auto-bind": "latest",
    "axios": "latest",
    "bidi-js": "latest",
    "chalk": "latest",
    "chokidar": "latest",
    "cli-boxes": "latest",
    "code-excerpt": "latest",
    "diff": "latest",
    "emoji-regex": "latest",
    "env-paths": "latest",
    "execa": "latest",
    "figures": "latest",
    "fuse.js": "latest",
    "get-east-asian-width": "latest",
    "google-auth-library": "latest",
    "highlight.js": "latest",
    "https-proxy-agent": "latest",
    "ignore": "latest",
    "indent-string": "latest",
    "jsonc-parser": "latest",
    "lodash-es": "latest",
    "lucide-react": "latest",
    "lru-cache": "latest",
    "marked": "latest",
    "p-map": "latest",
    "picomatch": "latest",
    "proper-lockfile": "latest",
    "qrcode": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-reconciler": "latest",
    "semver": "latest",
    "sharp": "latest",
    "shell-quote": "latest",
    "signal-exit": "latest",
    "stack-utils": "latest",
    "strip-ansi": "latest",
    "supports-hyperlinks": "latest",
    "tree-kill": "latest",
    "turndown": "latest",
    "type-fest": "latest",
    "undici": "latest",
    "usehooks-ts": "latest",
    "vscode-jsonrpc": "latest",
    "vscode-languageserver-protocol": "latest",
    "vscode-languageserver-types": "latest",
    "wrap-ansi": "latest",
    "ws": "latest",
    "xss": "latest",
    "yaml": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/react-dom": "latest",
    "@types/bun": "latest",
    "@types/lodash-es": "latest",
    "@types/node": "latest",
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-reconciler": "latest",
    "@types/semver": "latest",
    "@types/shell-quote": "latest",
    "@types/stack-utils": "latest",
    "@types/ws": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "vite": "latest",
    "typescript": "latest"
  },
  "build": {
    "appId": "local.claudecode.desktop",
    "productName": "ClaudeCode Local Desktop",
    "files": [
      "dist/desktop/**/*",
      "dist/desktop-agent/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist/desktop-agent/**/*"
    ],
    "directories": {
      "output": "release/desktop"
    }
  },
  "optionalDependencies": {
    "@ant/claude-for-chrome-mcp": "latest",
    "@ant/computer-use-input": "latest",
    "@ant/computer-use-mcp": "latest",
    "@ant/computer-use-swift": "latest",
    "audio-capture.node": "latest",
    "color-diff-napi": "latest",
    "modifiers-napi": "latest"
  }
}

